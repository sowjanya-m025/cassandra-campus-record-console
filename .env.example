PORT=3002
# Address the web server listens on. Keep 127.0.0.1: the console has no login and can run CQL.
HOST=127.0.0.1
CASSANDRA_HOSTS=127.0.0.1
# Host port published by docker-compose.yml (maps to 9042 inside the container)
CASSANDRA_PORT=9043
CASSANDRA_DC=datacenter1
# Set to false to skip inserting sample students on first start
SEED_ON_START=true
